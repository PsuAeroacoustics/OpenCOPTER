	"targetType": "dynamicLibrary",
	"lflags-linux": [
		"-L$HOME/.local/lib",
		"-L/usr/local/lib",
		"-L$CONDA_PREFIX/lib",
		"-L$HOME/.local/lib64",
		"-lsleef",
		"-llapacke",
		"-llapack",
		"-lopenblas",
		"-lgfortran"
	],
	"lflags-osx": ["-framework","Accelerate", "-Wl,-rpath,@loader_path/"],
	"excludedSourceFiles": [ "source/opencopter/cpp.d" ],
	"lflags-osx-x86_64": ["/usr/local/lib/libsleef.a"],
