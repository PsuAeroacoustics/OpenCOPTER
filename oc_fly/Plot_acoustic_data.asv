clc
clear all
%close all


% folder_name = {'.\Tander_system_rotor_only\FF_30mps_aoa_0_edgewise_acoustics\acoustics\'
%    '.\Tandem_system_2\FF_30mps_aoa_0_edge_wise_acoustics\acoustics\'};


folder_name = {'.\Tander_system_rotor_only\FF_30mps_aoa_0_acoustics\acoustics\'
    '.\Tandem_system_2\FF_30mps_aoa_0_acoustics\acoustics\'};

sub_folder_name = {'full_system'
    'rotor_0'
    'rotor_1'};

title_string=  {'Full System', 'Tilter Rotor', 'Lifter Rotor'};

for j = 1:3
    for i= 1:2
        % Read .tec file (skip header lines)
        filename = fullfile([folder_name{i},sub_folder_name{j}],'\spl\spl_spectrum.tec');
        fid = fopen(filename,'r');


        % --- Check file existence ---
        if exist(filename, 'file') ~= 2
            error('File not found: %s', filename);
        end

        % --- Open file ---
        fid = fopen(filename, 'r');
        if fid == -1
            error('Cannot open file: %s', filename);
        end

        % --- Skip header until numeric data starts ---
        line = '';
        while ischar(line)
            pos = ftell(fid);         % mark file position
            line = fgetl(fid);
            if isempty(line)
                continue;
            end
            % detect numeric line (starts with number or space)
            if ~isempty(regexp(strtrim(line), '^[0-9\.\-\+Ee]', 'once'))
                fseek(fid, pos, 'bof');  % rewind to start of data line
                break;
            end
        end

        % Read numeric data
        data = fscanf(fid, '%f %f %f %f %f %f %f', [7 Inf])';  % 5 = number of variables
        fclose(fid);

        % Assign variables
        freq(:,i) = data(:,1);
        thickness_spl(:,i) = data(:,2);
        loading_spl(:,i) = data(:,3);
        total_spl(:,i) = data(:,4);
        thickness_spl_dBA(:,i) = data(:,5);
        loading_spl_dBA(:,i) = data(:,6);
        total_spl_dBA(:,i) = data(:,7);
    end


    % % Plot example: contour of pressure
    % figure()
    % %semilogx(freq, thickness_spl, '-b', LineWidth=1.5)
    % %hold on
    % semilogx(freq, loading_spl(:,1), '-r', LineWidth=1.5)
    % %hold on
    % semilogx(freq, loading_spl(:,2), '-k', LineWidth=1.5)
    % xlabel("Frequency (Hz)")
    % ylabel("SPL (dB)")
    % legend("Without Wing", "With Wing")
    % grid on
    % grid minor

    figure()
    h1 = semilogx(freq, loading_spl(:,1), '-r', 'LineWidth', 1.5);
    hold on
    h2 = semilogx(freq, loading_spl(:,2), '-k', 'LineWidth', 1.5);

    xlabel("Frequency (Hz)", 'FontSize', 14, 'Interpreter', 'latex')
    ylabel("SPL (dB)", 'FontSize', 14, 'Interpreter', 'latex')
    legend([h1(1), h2(1)], {"Rotors Only", "Rotors + Wing"}, 'FontSize', 14, 'Interpreter', 'latex')  % explicitly map handles
    title(['Loading Nosie ',title_string{j}], 'FontSize', 14, 'Interpreter', 'latex')

    set(gca, 'FontName', 'Times New Roman', 'FontSize', 14)
    ylim([0, 90])
    xlim([35, 1000])
    grid on
    grid minor
end


